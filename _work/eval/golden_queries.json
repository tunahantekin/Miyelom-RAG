            {"icerik": ["(?i)bone marrow|kemik ili", "(?i)fish"]}],
  "gerekce": "NCCN MYEL-1 iş akışı; aynı bilgi parse edilmiş NCCN PDF'inde ve dergi sürümünde de var",
  "katman": "klinik"
 },
 {
